    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.6.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.3"
  }
